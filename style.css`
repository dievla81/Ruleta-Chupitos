body {
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    background-color: #1a1a2e;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    color: white;
}

.game-container {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
}

h1 {
    font-size: 2.5rem;
    text-shadow: 0 0 10px rgba(255,255,255,0.5);
    margin-bottom: 1rem;
}

.roulette-wrapper {
    position: relative;
    width: 500px;
    height: 500px;
}

.wheel {
    width: 100%;
    height: 100%;
    background-image: url('../Ruleta.jpg');
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    border-radius: 50%;
    box-shadow: 0 0 50px rgba(0,0,0,0.5), 0 0 20px rgba(255,255,255,0.2);
    transition: transform 4s cubic-bezier(0.15, 0, 0.15, 1);
}

.pointer {
    position: absolute;
    top: -30px;
    left: 50%;
    transform: translateX(-50%);
    width: 80px;
    height: 80px;
    background-image: url('../Flecha.png');
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    z-index: 10;
    filter: drop-shadow(0 2px 5px rgba(0,0,0,0.5));
}

.center-logo {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 70px; /* Reducido para que encaje en el círculo azul */
    height: 70px;
    background-image: url('../logo_blanco.png');
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    z-index: 11;
    pointer-events: none;
}

#spin-button {
    padding: 1rem 3rem;
    font-size: 1.5rem;
    font-weight: bold;
    cursor: pointer;
    background: #1a3a6c;
    border: 2px solid #ffffff;
    border-radius: 50px;
    color: #ffffff;
    transition: transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 5px 15px rgba(0,0,0,0.3);
}

#spin-button:hover {
    transform: scale(1.05);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.5);
}

#spin-button:disabled {
    background: #555;
    cursor: not-allowed;
    transform: scale(1);
}

/* Modal styles */
.modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.85);
    justify-content: center;
    align-items: center;
    z-index: 100;
    backdrop-filter: blur(5px);
}

.modal-content {
    background-image: url('../TarjetaPenitencia.png');
    background-size: 100% 100%;
    background-repeat: no-repeat;
    background-position: center;
    color: #333;
    padding: 0;
    border-radius: 20px;
    text-align: center;
    max-width: 500px;
    width: 90%;
    animation: popIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

/* Contenedor interno para centrar el texto exactamente en el espacio blanco */
.card-inner-content {
    width: 70%;
    margin-top: 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
}

.modal-content::before {
    content: "";
    position: absolute;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    width: 80px;
    height: 80px;
    background-image: url('../logo_blanco.png');
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}

@keyframes popIn {
    from { transform: scale(0.5); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
}

#slot-name {
    display: block;
    font-size: 1.2rem;
    font-weight: bold;
    color: #666;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
}

#slot-action {
    font-size: 1.6rem;
    font-weight: bold;
    color: #1a3a6c;
    margin-bottom: 1rem;
    line-height: 1.4;
    text-shadow: 1px 1px 0px #fff;
}

#close-modal {
    position: absolute;
    bottom: 50px;
    left: 50%;
    transform: translateX(-50%);
    padding: 0.8rem 2rem;
    font-size: 1.2rem;
    cursor: pointer;
    background: #1a3a6c;
    color: white;
    border: none;
    border-radius: 10px;
}

@media (max-width: 600px) {
    .roulette-wrapper {
        width: 300px;
        height: 300px;
    }
    h1 {
        font-size: 1.8rem;
    }
    #spin-button {
        font-size: 1.2rem;
        padding: 0.8rem 2rem;
    }
}
